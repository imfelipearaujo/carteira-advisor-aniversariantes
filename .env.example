# --- Obrigatórias ------------------------------------------------------------
CARTEIRA_ADVISOR_BASE_URL=https://api-prod.carteiradeinvestimentos.com/v1/user
CARTEIRA_ADVISOR_PATRIMONY_BASE_URL=https://api-prod.carteiradeinvestimentos.com/v1/trade-rules
CARTEIRA_ADVISOR_TOKEN=

# Registros especiais (sem CPF individual por natureza: cadastro familiar,
# carteira de simulação). Ficam fora da planilha de aniversariantes, mas são
# contabilizados na auditoria cadastral. Informe os IDs reais apenas no .env
# local (nunca neste arquivo). Exemplo fictício: 1001,1002
CARTEIRA_ADVISOR_SPECIAL_CLIENT_IDS=

# Modo de execução. false (padrão): só clientes, consultores e uma leitura do
# consolidado (auditoria cadastral) — rápido, 3 requisições. true: auditoria
# financeira completa (detalhes de cada carteira, PTAX, diagnóstico, verificação
# temporal), uma requisição por carteira.
CARTEIRA_ADVISOR_DETAILED_AUDIT=false

# Limite de requisições por minuto ao Carteira Advisor (fornecedor: 50/min).
# CARTEIRA_ADVISOR_MAX_REQUESTS_PER_MINUTE=50

# --- Opcionais (ajustar somente após confirmação no Swagger/fornecedor) -------
# Header e prefixo do token. Padrão confirmado em produção: "token: <token>".
# CARTEIRA_ADVISOR_AUTH_HEADER=token
# CARTEIRA_ADVISOR_AUTH_SCHEME=

# Caminho do endpoint de patrimônio, relativo a CARTEIRA_ADVISOR_PATRIMONY_BASE_URL.
# CARTEIRA_ADVISOR_CONSOLIDATED_PL_PATH=/company-api/wallet/consolidated-pl

# Parâmetros de paginação (índice de página começa em 0).
# CARTEIRA_ADVISOR_PAGE_PARAM=page
# CARTEIRA_ADVISOR_SIZE_PARAM=size
# CARTEIRA_ADVISOR_PAGE_SIZE=100

# CARTEIRA_ADVISOR_TIMEOUT_SECONDS=30
# CARTEIRA_ADVISOR_MAX_RETRIES=3

# Unidade monetária da API: reais | centavos
# CARTEIRA_ADVISOR_MONEY_UNIT=reais

# Política de carteiras: unconfirmed | mutually_exclusive
# Só altere para mutually_exclusive com confirmação formal de que
# wallets[] nunca contém carteiras agregadoras. Ver docs/DECISIONS.md.
# CARTEIRA_ADVISOR_WALLET_POLICY=unconfirmed

# Auditoria multimoeda: consulta /company-api/wallet/{id} (1 requisição por
# carteira, depois da publicação da planilha). Intervalo mínimo entre consultas
# em milissegundos; a API responde HTTP 429 com intervalos curtos.
# CARTEIRA_ADVISOR_WALLET_DETAILS=true
# CARTEIRA_ADVISOR_WALLET_DETAIL_INTERVAL_MS=1000

# Verificação independente de coerência patrimonial com a PTAX (Banco Central).
# A PTAX é uma referência externa, NÃO a cotação oficial do Carteira Advisor.
# Roda depois da publicação da planilha; falhas não afetam o Excel.
# CARTEIRA_ADVISOR_FX_CHECK=true
# CARTEIRA_ADVISOR_PTAX_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1
# Idade máxima (dias) da PTAX em relação à consolidação de cada carteira.
# CARTEIRA_ADVISOR_PTAX_WINDOW_DAYS=10
# Divergência (%) a partir da qual o cliente é listado como relevante (diagnóstico).
# CARTEIRA_ADVISOR_FX_RELEVANT_PCT=5
# Limites patrimoniais em R$ para sinalizar clientes que mudam de lado (opcional).
# CARTEIRA_ADVISOR_PATRIMONY_THRESHOLDS=1000000,5000000
# Relatório local por cliente em output/diagnostico (contém dados pessoais; fora do Git).
# CARTEIRA_ADVISOR_DIAGNOSTIC_REPORT=true
